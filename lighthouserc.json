{
  "ci": {
    "collect": {
      "startServerCommand": "npx http-server . -p 4174 -s",
      "url": ["http://localhost:4174/index.html"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 0.8 }],
        "installable-manifest": ["error", { "minScore": 1 }],
        "service-worker": ["error", { "minScore": 1 }],
        "viewport": ["error", { "minScore": 1 }],
        "splash-screen": ["error", { "minScore": 1 }],
        "themed-omnibox": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report"
    }
  }
}